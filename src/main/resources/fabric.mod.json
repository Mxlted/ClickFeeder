{
    "schemaVersion": 1,
    "id": "clickfeeder",
    "version": "${version}",
    "name": "ClickFeeder",
    "description": "Right-click with breeding food to feed eligible nearby adult animals in range. Ignores babies and auto-restocks from inventory when hotbar runs out.",
    "icon": "assets/clickfeeder/icon.png",
    "authors": ["User"],
    "contact": {},
    "license": "MIT",
    "environment": "client",
    "entrypoints": {
        "client": ["com.clickfeeder.ClickFeeder"]
    },
    "depends": {
        "fabricloader": ">=${loader_version}",
        "fabric-api": "${fabric_api_dependency}",
        "minecraft": "${minecraft_version_range}",
        "java": ">=${java_version}"
    }
}
