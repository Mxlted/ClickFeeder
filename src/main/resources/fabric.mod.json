{
    "schemaVersion": 1,
    "id": "clickfeeder",
    "version": "${version}",
    "name": "ClickFeeder",
    "description": "Right-click with breeding food to feed nearby adult animals. Includes hotbar switching, inventory restocking, and optional settings.",
    "icon": "assets/clickfeeder/icon.png",
    "authors": ["Mxlted"],
    "contact": {
        "homepage": "https://modrinth.com/mod/clickfeeder",
        "sources": "https://github.com/Mxlted/ClickFeeder",
        "issues": "https://github.com/Mxlted/ClickFeeder/issues"
    },
    "license": "MIT",
    "environment": "client",
    "entrypoints": {
        "client": ["com.clickfeeder.ClickFeeder"],
        "modmenu": ["com.clickfeeder.config.ModMenuIntegration"]
    },
    "suggests": {
        "modmenu": "*",
        "cloth-config": "*"
    },
    "depends": {
        "fabricloader": ">=${loader_version}",
        "fabric-api": "${fabric_api_dependency}",
        "minecraft": "${minecraft_version_range}",
        "java": ">=${java_version}"
    }
}
